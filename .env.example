# Crosswalk Wisdom — frontend env (Vite). Copy real values into .env (gitignored).

# Existing: webhook for Encharge form captures
VITE_API_URL=https://crosswalk-webhook.up.railway.app

# Glute Longevity training SaaS — from Supabase Dashboard → Project Settings → API.
# The anon key is public-by-design (safe in the browser); RLS protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
